// Committed build configuration. Pulls in your local, gitignored
// Secrets.xcconfig if it exists (see Secrets.example.xcconfig to set one
// up) - the "?" makes this include optional so a fresh checkout still
// builds without it (OPENROUTER_API_KEY just resolves empty).

#include? "Secrets.xcconfig"

OPENROUTER_MODEL = google/gemma-4-31b-it:free
