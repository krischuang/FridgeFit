<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  FridgeFit privacy manifest.

	  Required for App Store submission. Describes what the app collects, and
	  declares the reason for each "required reason" API it uses.

	  Scope note: the declarations below cover FridgeFit's own code. Firebase
	  and GoogleSignIn ship their own privacy manifests inside their
	  XCFrameworks, which Xcode aggregates into the privacy report at archive
	  time - they are deliberately not restated here.

	  WHAT THE SHIPPING CONFIGURATION ACTUALLY DOES
	  (PersistenceConfiguration.compiledDefault == .swiftData):

	    - Pantry, kitchen activity, saved recipes, budget, grocery spends,
	      waste records and saved prices: ON DEVICE ONLY, in SwiftData. None
	      of it is uploaded. See StorageDisclosure, which is the same
	      statement rendered in Profile -> Settings.
	    - Email address: Firebase Authentication. Always.
	    - Remote-camera device names and WebRTC signalling messages:
	      Firestore, under users/{uid}. Always, because two devices cannot
	      find each other through a local database.

	  "Other User Content" is declared anyway. In the .firebase build
	  configuration the pantry and the FridgeFunds figures are stored in
	  Firestore, and the remote-camera device registry stores a user-chosen
	  device name in every configuration. Declaring collection that may not
	  occur is safe; omitting collection that does occur is not.

	  Account deletion: users/{uid} and every collection beneath it, plus the
	  local SwiftData rows and on-device caches, are removed by the in-app
	  Delete Account flow. See FirestoreAccountDataDeleter and
	  SwiftDataAccountDataDeleter.
	-->

	<!-- No tracking. Nothing is shared with data brokers, and there is no
	     advertising or cross-app identifier anywhere in the project. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  Email address, via Firebase Authentication. Used only to identify
		  the account that owns a pantry - it is the uid behind
		  users/{uid} in Firestore and behind ownerID in the local store.
		  Not used for tracking, not used for advertising.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
		  Other user content, covering two things:

		  1. The pantry, the kitchen activity log, saved recipes and the
		     FridgeFunds figures - ONLY when the app is built against the
		     Firebase backend. In the shipping SwiftData configuration none
		     of this leaves the device.
		  2. The remote-camera device name, in every configuration, so a
		     user can tell their two iPhones apart when pairing.

		  Both are stored under the signed-in user's own uid and are readable
		  by nobody else (see firestore.rules).
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
		  Food intolerances, and the pantry ingredient names searched with
		  them, when the Discover tab performs an online recipe search.

		  Traced, not assumed: SpoonacularRecipeService builds the query with
		  `intolerances` (FoodIntolerance: dairy, egg, gluten, grain, peanut,
		  seafood, sesame, shellfish, soy, sulfite, tree nut, wheat), `diet`
		  and `includeIngredients` (the pantry names), and sends them to
		  api.spoonacular.com. OnlineRecipeFeature.provider is `.enabled`, so
		  this path is live in any build configured with a key.

		  Declared as Health because a food intolerance is user-provided
		  health information, and NOT linked to the user because the request
		  carries no uid, account, email or device identifier - only the
		  developer's API key. Searches are not used for tracking and are
		  never joined to a FridgeFit account.

		  Spoonacular's own retention is outside FridgeFit's control and is
		  recorded as an external requirement in
		  docs/assessment4-privacy-compliance-audit.md. Declaring it here is
		  the safe side of that uncertainty.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
		  Search contents: the ingredient names and the time limit sent with
		  the same request. Separate from the pantry entry above because that
		  one is linked (it is stored under users/{uid} in Firebase mode) and
		  this one is not - the search leaves no identifier behind.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeSearchHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
		  Photos and camera video are deliberately NOT declared as collected.

		  Fridge photos are analysed on-device by CoreML and Vision, and the
		  receipt scanner's image never reaches a language model. In Camera
		  Mode, video is streamed directly between two devices signed into the
		  same account over WebRTC. None of it is uploaded to FridgeFit or
		  retained by the developer, which is also what NSCameraUsageDescription
		  tells the user.
		-->
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults. Five uses, all of them this app's own settings:
		  the Discover tab's search filters (OnlineRecipePreferencesStore),
		  hidden Discover results (HiddenOnlineRecipeStore), the Profile
		  measurement/serving preferences (ProfileSettingsStore), this
		  device's remote-camera identity (DeviceIdentity), and the
		  persistence backend launch argument (PersistenceConfiguration).
		  Reason CA92.1 - access to the app's own defaults.

		  The first three are cleared by the in-app Delete Account flow; see
		  LocalStateAccountDataDeleter, which also documents why the device
		  identity is deliberately kept.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
