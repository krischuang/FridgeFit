// Copy this file to Secrets.xcconfig (same directory) and fill in your own
// values. Secrets.xcconfig is gitignored - it never gets committed.
// Config.xcconfig includes it automatically if present.
//
//     cp Secrets.xcconfig.example Secrets.xcconfig
//
// Every setting here is optional. With no Secrets.xcconfig at all the app
// still builds and runs in the simulator; only the features that need a
// value are affected.


// --- Signing -------------------------------------------------------------
// Your 10-character Apple Development Team ID. Required only to run on a
// physical device; simulator builds don't need it. Find it in Xcode under
// Settings -> Accounts -> your Apple ID -> Team ID, or at
// https://developer.apple.com/account (Membership details).
// LOCAL_DEVELOPMENT_TEAM = ABCDE12345

// Appended to the bundle identifier, which defaults to com.Fridge.FridgeFit.
// Leave this unset unless device installs fail with a provisioning error -
// that happens when your Apple ID can't claim the default id. A suffix like
// ".yourname" gives you com.Fridge.FridgeFit.yourname.
//
// Note: the committed GoogleService-Info.plist is registered against
// com.Fridge.FridgeFit. Firebase logs a bundle-id mismatch warning with a
// suffix set but keeps working, and Google Sign-In is unaffected because it
// keys off CLIENT_ID. See README "Bundle Identifier".
// LOCAL_BUNDLE_ID_SUFFIX = .yourname


// --- OpenRouter (ingredient substitutions) -------------------------------
// Get a key at https://openrouter.ai/keys
// Without it the app runs normally and the substitutions feature reports
// itself as not configured instead of failing.
OPENROUTER_API_KEY = your-openrouter-api-key-here

// Optional - defaults to a free model in Config.xcconfig if omitted here.
// OPENROUTER_MODEL = google/gemma-4-31b-it:free
