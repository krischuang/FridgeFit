rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's pantry lives at users/{uid}/pantry/{pantryItemId}.
    // A signed-in user may only read or write their own pantry - uid in
    // the path must match the authenticated request's uid.
    match /users/{uid}/pantry/{pantryItemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FridgeFunds (budget, spends, waste, item prices) - same rule, own data only.
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && collection in ['fundsBudget', 'fundsSpends', 'fundsWaste', 'fundsItemPrices'];
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
