rules_version = '2';

// FridgeFit Firestore security rules.
//
// Everything the app stores lives under users/{uid}/..., and the single
// security boundary is "the signed-in user owns the uid in the path". That
// is what makes a Firebase account - not a client-side filter - the limit of
// what any device can see.
//
// Paths in use (see FirestorePantryRepository, FirestoreDeviceRegistry and
// FirestoreSignalingTransport):
//
//   users/{uid}/pantry/{pantryItemId}
//   users/{uid}/inventoryEvents/{eventId}
//   users/{uid}/devices/{deviceId}
//   users/{uid}/webrtcSessions/{sessionId}
//   users/{uid}/webrtcSessions/{sessionId}/callerCandidates/{candidateId}
//   users/{uid}/webrtcSessions/{sessionId}/calleeCandidates/{candidateId}
//   users/{uid}/fundsBudget/current
//   users/{uid}/fundsSpends/{spendId}
//   users/{uid}/fundsWaste/{wasteId}
//   users/{uid}/fundsItemPrices/{pantryItemId}
//   users/{uid}/fundsPriceBook/{encodedIngredientName}
//
// Covered by FirestoreRulesTests (`npm test` in firestore-tests/), which runs
// these rules against the Firestore emulator.

service cloud.firestore {
  match /databases/{database}/documents {

    // The one authorisation question these rules can answer: is the caller
    // signed in, and is this their own subtree?
    //
    // Note it deliberately says nothing about *which device* is asking -
    // deviceId is not part of the auth token, so per-device authorisation is
    // enforced client-side in WebRTCSessionCoordinator, which refuses any
    // session not addressed to it and refuses to answer its own offer.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // --- The account-deletion write lock ----------------------------------
    //
    // While a server-side deletion job is in flight, the Cloud Function
    // writes deletionLocks/{uid}. Its presence makes every write below fail.
    //
    // Why this is needed: deleting a user's data is not instantaneous, and
    // without this the app could add a pantry item into a subtree that is
    // halfway through being deleted. The item would then survive the
    // deletion that was supposed to remove everything, and the account would
    // be reported as deleted while still owning data.
    //
    // Reads are deliberately left alone. A user whose deletion is running
    // may still have the app open, and letting it render what is there -
    // while refusing to add to it - is better than the screen erroring.
    //
    // Cost: one extra `exists()` on each user write. Writes in this app are
    // user-initiated and infrequent (adding food, logging a spend), so this
    // is the right place to pay for correctness.
    function isNotBeingDeleted(uid) {
      return !exists(/databases/$(database)/documents/deletionLocks/$(uid));
    }

    // The common case: the caller owns this subtree and it is not being
    // deleted out from under them.
    function canWrite(uid) {
      return isOwner(uid) && isNotBeingDeleted(uid);
    }

    // --- Deletion bookkeeping ---------------------------------------------
    //
    // Both documents are written by the Cloud Functions Admin SDK, which
    // bypasses these rules entirely. The rules therefore grant the *client*
    // read-only access, so the app can show honest progress, and no write
    // access at all - a client that could delete its own lock could write
    // into a subtree mid-deletion, and a client that could edit its own job
    // could mark itself "completed" without anything having happened.
    match /deletionJobs/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /deletionLocks/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // --- Pantry (pre-existing, unchanged behaviour) -----------------------
    //
    // A signed-in user may only read or write their own pantry.
    match /users/{uid}/pantry/{pantryItemId} {
      allow read: if isOwner(uid);
      allow write: if canWrite(uid);
    }

    // --- Kitchen activity history -----------------------------------------
    //
    // One document per committed action - added, used, finished, discarded,
    // quantity corrected (see InventoryEvent and
    // FirestoreInventoryEventRepository).
    //
    // Its own match rather than sharing the pantry's: a rule on one
    // collection does not cover a sibling, and these documents outlive the
    // pantry item they describe - finishing food removes the item but keeps
    // its history, which is the only place "we ate it" and "we threw it out"
    // stay distinguishable.
    //
    // `read` covers the ordered, limited query the activity sheet runs.
    // `write` covers appending an event and the batched delete that backs
    // undo. Deliberately no narrower than the pantry it sits beside: the
    // security boundary is the uid in the path, and nothing here is readable
    // or writable by anyone else's account.
    match /users/{uid}/inventoryEvents/{eventId} {
      allow read: if isOwner(uid);
      allow write: if canWrite(uid);
    }

    // --- Recipes saved from Discover --------------------------------------
    //
    // One document per recipe the user saved from an online search, holding
    // the converted `Recipe` as JSON (see FirestoreSavedRecipeRepository and
    // SaveOnlineRecipeUseCase). Same own-data-only boundary as the pantry.
    //
    // `read` covers the ordered query the Recipes tab runs over savedAt.
    // `write` covers saving (which overwrites by recipe id, so saving the
    // same recipe twice is idempotent) and removing.
    //
    // Deployment state is external to this repository and must be verified in
    // the Firebase project before release. Deployments must keep this rule in
    // sync with the enabled client feature; denied writes surface through the
    // existing save error.
    match /users/{uid}/savedRecipes/{recipeId} {
      allow read: if isOwner(uid);
      allow write: if canWrite(uid);
    }

    // --- Remote camera: device registry -----------------------------------
    //
    // One document per install, so the app can tell two iPhones on the same
    // account apart - a Firebase UID identifies the account, not the phone
    // (see DeviceIdentity).
    //
    // `read` covers both getting a single device and listing the collection,
    // which is how discovery and the presence heartbeat work. `write` covers
    // registration (create), heartbeat and role changes (update), and
    // removal (delete).
    match /users/{uid}/devices/{deviceId} {
      allow read: if isOwner(uid);
      allow write: if canWrite(uid);
    }

    // --- Remote camera: WebRTC signaling ----------------------------------
    //
    // Carries SDP offers/answers and ICE candidates only. Video frames and
    // captured photos never pass through Firestore - they go peer-to-peer
    // over WebRTC.
    //
    // `read` also covers the two queries the app runs here: a camera listens
    // for sessions where calleeDeviceId == its own id, and the controller
    // sweeps sessions whose expiresAt has passed.
    match /users/{uid}/webrtcSessions/{sessionId} {
      allow read: if isOwner(uid);
      allow write: if canWrite(uid);
    }

    // ICE candidates, in a subcollection per negotiating role.
    //
    // This needs its own match: a rule on the parent document does NOT cascade
    // to its subcollections. Without this block the session document would be
    // readable but candidates would be denied, and connections would get as
    // far as exchanging SDP and then never complete - which is the failure
    // mode most easily mistaken for a networking problem.
    //
    // The collection name is restricted to the two the app actually uses
    // (see SignalingRole.candidateCollectionName) rather than a recursive
    // wildcard, so this grants no more than the feature needs.
    match /users/{uid}/webrtcSessions/{sessionId}/{candidateCollection}/{candidateId} {
      allow read: if isOwner(uid)
        && candidateCollection in ['callerCandidates', 'calleeCandidates'];
      allow write: if canWrite(uid)
        && candidateCollection in ['callerCandidates', 'calleeCandidates'];
    }

    // --- FridgeFunds (Profile → Impact & Budget) ---------------------------
    //
    // The active budget, logged grocery spends, valued waste, the price
    // attached to each pantry item, and the per-ingredient price book - see
    // FirestoreBudgetStore, FirestoreItemPriceStore and
    // FirestorePriceBookStore. Same own-data-only boundary as the pantry.
    //
    // Restricted to the five collection names the module actually uses
    // rather than a wildcard, for the same reason as the ICE candidate rule
    // above.
    match /users/{uid}/{fundsCollection}/{docId} {
      allow read: if isOwner(uid)
        && fundsCollection in ['fundsBudget', 'fundsSpends', 'fundsWaste', 'fundsItemPrices', 'fundsPriceBook'];
      allow write: if canWrite(uid)
        && fundsCollection in ['fundsBudget', 'fundsSpends', 'fundsWaste', 'fundsItemPrices', 'fundsPriceBook'];
    }

    // --- Default deny -----------------------------------------------------
    //
    // Anything not matched above. Note that in Firestore an `allow` elsewhere
    // is OR'd in, so this cannot override the rules above - it only closes
    // off paths nothing has granted.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
