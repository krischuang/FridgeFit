rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's pantry lives at users/{uid}/pantry/{pantryItemId}.
    // A signed-in user may only read or write their own pantry - uid in
    // the path must match the authenticated request's uid.
    match /users/{uid}/pantry/{pantryItemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Recipes saved from Discover live at users/{uid}/savedRecipes/{recipeId},
    // under the same own-data-only rule as the pantry.
    match /users/{uid}/savedRecipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
